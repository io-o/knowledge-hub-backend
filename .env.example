PORT=3000

# 生产镜像，CI 推到 GHCR 后填写，例如 ghcr.io/your-org/knowledge-hub-backend:latest
APP_IMAGE=ghcr.io/your-org/knowledge-hub-backend:latest

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB（本地开发用完整 URI；生产 compose 会按服务名 mongodb 覆盖）
MONGO_USER=mongo_user
MONGO_PASSWORD=mongo_pass123
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# Snowflake (snowflake-id: mid 0–1023)
SNOWFLAKE_WORKER_ID=1
# Epoch offset ms; default ≈ 2024-01-01
SNOWFLAKE_OFFSET=1704067200000
